{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs && npm run build"
  },
  "bundle": {
    "externalBin": [
      "binaries/idm-host"
    ],
    "resources": {
      "../../extension/.output/chrome-mv3/": "extension/chrome-mv3/",
      "../../extension/.output/firefox-mv2/": "extension/firefox-mv2/"
    },
    "publisher": "farza",
    "shortDescription": "OurIDM download manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh",
        "startMenuFolder": "OurIDM",
        "template": "installer/installer.nsi"
      }
    }
  }
}