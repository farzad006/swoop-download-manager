{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs && npm run build"
  },
  "bundle": {
    "externalBin": [
      "binaries/swoop-host"
    ],
    "resources": {
      "../../extension/.output/chrome-mv3/": "extension/chrome-mv3/",
      "../../extension/.output/firefox-mv2/": "extension/firefox-mv2/"
    },
    "publisher": "Ali Studio",
    "shortDescription": "Swoop, the download manager by Ali Studio",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh",
        "template": "installer/installer.nsi",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "© 2026 Ali Studio"
  }
}
