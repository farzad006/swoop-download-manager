{
  "name": "swoop-extension",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
